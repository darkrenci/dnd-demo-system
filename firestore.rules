rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /characters/{charId} {
      allow read, write: if true;
    }

    match /campaigns/{campaignId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
